{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/launch",
      "destination": "/LP?tab=launch",
      "permanent": true
    },
    {
      "source": "/whitepaper",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/Impact",
      "destination": "/impact",
      "permanent": true
    },
    {
      "source": "/lp",
      "destination": "/LP",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/contracts/vote/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://rpc.mainnet.chain.robinhood.com; img-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/contracts/launch-v3/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://rpc.mainnet.chain.robinhood.com; img-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/contracts/launch-v2/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://rpc.mainnet.chain.robinhood.com; img-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/impact",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/LP",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://rpc.mainnet.chain.robinhood.com; img-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/LP.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://rpc.mainnet.chain.robinhood.com; img-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/integrations/bankr-ballot.json",
      "destination": "/api/write-in-quote?ballot=1"
    },
    {
      "source": "/integrations/dextools/latest-block",
      "destination": "/api/lp-launches?dextools=latest-block"
    },
    {
      "source": "/integrations/dextools/block",
      "destination": "/api/lp-launches?dextools=block"
    },
    {
      "source": "/integrations/dextools/asset",
      "destination": "/api/lp-launches?dextools=asset"
    },
    {
      "source": "/integrations/dextools/asset/holders",
      "destination": "/api/lp-launches?dextools=asset/holders"
    },
    {
      "source": "/integrations/dextools/exchange",
      "destination": "/api/lp-launches?dextools=exchange"
    },
    {
      "source": "/integrations/dextools/pair",
      "destination": "/api/lp-launches?dextools=pair"
    },
    {
      "source": "/integrations/dextools/events",
      "destination": "/api/lp-launches?dextools=events"
    },
    {
      "source": "/tokenlist.json",
      "destination": "/api/lp-launches?format=tokenlist"
    },
    {
      "source": "/launchpad.json",
      "destination": "/api/lp-launches?format=manifest"
    },
    {
      "source": "/tokens-sitemap.xml",
      "destination": "/api/lp-launches?format=sitemap"
    },
    {
      "source": "/tokens/:address.json",
      "destination": "/api/lp-launches?format=metadata&address=:address"
    },
    {
      "source": "/tokens/:address",
      "destination": "/api/lp-launches?format=page&address=:address"
    }
  ]
}
